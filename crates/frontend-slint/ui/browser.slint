import { LineEdit, ScrollView } from "std-widgets.slint";

// Native projections of the Rust workspace store; no filesystem or CEF here.
export struct TabView {
    id: int,
    title: string,
    active: bool,
}

export struct SpaceView {
    id: int,
    title: string,
    active: bool,
    color: color,
    color-hex: string,
    icon: string,
    count: int,
}
export struct SavedView {
    id: int,
    resource-id: int,
    folder: bool,
    title: string,
    subtitle: string,
    notes: string,
    tags: string,
    color: color,
    color-hex: string,
    icon: string,
    glyph: string,
    depth: int,
    pinned: bool,
    favorite: bool,
    live: bool,
}
export struct SearchView {
    kind: int, // 0=tab, 1=saved resource, 2=workspace
    workspace-id: int,
    tab-id: int,
    resource-id: int,
    title: string,
    subtitle: string,
    glyph: string,
    color: color,
}
export struct DestinationView {
    workspace-id: int,
    folder-id: int,
    title: string,
    depth: int,
}

component SearchRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> glyph;
    in property <color> accent;
    callback selected();

    height: 47px;
    border-radius: 8px;
    background: result-hit.has-hover || result-focus.has-focus ? #34384e : #252a3a;
    accessible-role: list-item;
    accessible-label: root.title + " — " + root.subtitle;
    result-focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.selected(); accept }
            else { reject }
        }
    }
    result-hit := TouchArea { clicked => { root.selected(); } }
    HorizontalLayout {
        padding-left: 7px;
        spacing: 6px;
        Text { text: root.glyph; color: root.accent; vertical-alignment: center; font-size: 16px; }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Text { text: root.title; color: #ececf6; font-size: 12px; overflow: elide; }
            Text { text: root.subtitle; color: #8d98b3; font-size: 10px; overflow: elide; }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> description: label;
    in property <color> label-color: #9ba3b8;
    in property <length> button-size: 34px;
    callback clicked();

    width: root.button-size;
    height: root.button-size;
    border-radius: 9px;
    background: hit.pressed ? #343b50 : (hit.has-hover || keyboard.has-focus ? #292e40 : #00000000);
    accessible-role: button;
    accessible-label: root.description;

    Text {
        text: root.label;
        color: hit.has-hover || keyboard.has-focus ? #ececf6 : root.label-color;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                accept
            } else { reject }
        }
    }
    hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SidebarSpace inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in property <color> accent;
    in property <int> count;
    in property <bool> active;
    callback chosen();
    callback editing();

    height: 38px;
    border-radius: 9px;
    border-width: root.active ? 1px : 0px;
    border-color: #ffffff28;
    background: root.active ? root.accent.mix(#20242f, 0.30) : (space-hit.has-hover ? root.accent.mix(#222432, 0.18) : #222432);
    accessible-role: list-item;
    accessible-label: root.title;
    space-hit := TouchArea { clicked => { root.chosen(); } }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 5px;
        spacing: 5px;
        Text { text: root.glyph; color: root.accent; font-size: 17px; vertical-alignment: center; }
        Text { text: root.title; color: #dfe1ee; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: "" + root.count; color: #9299ad; font-size: 11px; vertical-alignment: center; }
        IconButton { button-size: 25px; label: "⋯"; description: "Modifier l'espace"; clicked => { root.editing(); } }
    }
}

component SavedRow inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in property <color> accent;
    in property <int> depth;
    in property <bool> folder;
    in property <bool> pinned;
    in property <bool> can-pin: true;
    in property <bool> favorite;
    in property <bool> live;
    callback opened();
    callback editing();
    callback pin-clicked();
    callback favorite-clicked();

    height: 40px;
    border-radius: 8px;
    background: open-area.has-hover ? root.accent.mix(#222432, 0.20) : root.accent.mix(#222432, 0.08);
    accessible-role: list-item;
    accessible-label: root.title;
    open-area := TouchArea { clicked => { if (root.folder) { root.editing(); } else { root.opened(); } } }
    HorizontalLayout {
        padding-left: 5px + 12px * root.depth;
        padding-right: 3px;
        spacing: 5px;
        Text { text: root.glyph; color: root.accent; font-size: 15px; vertical-alignment: center; }
        Text { text: root.title; color: #d3d5e4; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        if (!root.folder): IconButton {
            button-size: 24px;
            label: root.favorite ? "★" : "☆";
            description: root.favorite ? "Retirer des favoris" : "Ajouter aux favoris";
            clicked => { root.favorite-clicked(); }
        }
        if (!root.folder && root.can-pin): IconButton {
            button-size: 24px;
            label: root.pinned ? "◆" : "◇";
            description: root.pinned ? "Désépingler" : "Épingler";
            clicked => { root.pin-clicked(); }
        }
        IconButton { button-size: 25px; label: "⋯"; description: "Organiser ou personnaliser"; clicked => { root.editing(); } }
    }
}

component SidebarTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback activated();
    callback closed();
    callback organizing();

    height: 45px;
    border-radius: 10px;
    border-width: root.active ? 1px : 0px;
    border-color: #bfaffc31;
    background: root.active ? #302d46 : (activate-hit.has-hover ? #292c3d : #222433);
    accessible-role: list-item;
    accessible-label: root.title;

    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activated();
                accept
            } else { reject }
        }
    }
    activate-hit := TouchArea {
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 7px;
        Rectangle {
            width: 25px;
            height: 25px;
            border-radius: 7px;
            background: root.active ? #655484 : #343349;
            Text {
                text: "◫";
                color: root.active ? #e0d5ff : #9f9ab8;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            color: root.active ? #eeeafd : #bec2d3;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        IconButton {
            label: "⋯";
            description: "Organiser l'onglet " + root.title;
            button-size: 26px;
            clicked => { root.organizing(); }
        }
        IconButton {
            label: "×";
            description: "Fermer l'onglet " + root.title;
            button-size: 26px;
            clicked => { root.closed(); }
        }
    }
}

export component BrowserWindow inherits Window {
    title: "Aster Browser";
    preferred-width: 1280px;
    preferred-height: 790px;
    min-width: 650px;
    min-height: 430px;
    background: #10121b;

    in property <[SpaceView]> spaces;
    in property <[SavedView]> saved-items;
    in property <[SavedView]> favorites;
    in property <[DestinationView]> destinations;
    in property <[SearchView]> search-results;
    in property <int> active-workspace-id: 1;
    in property <string> workspace-message;
    private property <bool> favorites-only: false;
    private property <string> search-query: "";
    private property <int> search-scope: 0; // 0=all, 1=tabs, 2=resources, 3=favorites
    // In-panel editor state, entirely transient; validation happens in Rust.
    private property <int> editor-mode: 0; // 1=space, 2=folder, 3=resource, 4=URL, 5=move
    private property <int> editor-id: 0;
    private property <int> editor-resource-id: 0;
    private property <int> editor-tab-id: 0;
    private property <int> editor-parent-id: 0;
    private property <string> editor-title: "";
    private property <string> editor-url: "";
    private property <string> editor-notes: "";
    private property <string> editor-tags: "";
    private property <string> editor-color: "#9ddac8";
    private property <string> editor-icon: "grid";
    private property <bool> confirm-delete: false;
    in property <[TabView]> tabs;
    in property <int> active-tab-id: -1;
    in property <string> current-url;
    in property <string> status-text;
    in property <image> page-image;
    in property <bool> has-page;
    out property <int> viewport-width: page-surface.width / 1px;
    out property <int> viewport-height: page-surface.height / 1px;

    // Transient UI state only, never a Chromium tab property.
    private property <bool> sidebar-open: false;
    private property <bool> sidebar-locked: false;

    callback add-tab();
    callback close-tab(int);
    callback select-tab(int);
    callback navigate(string);
    callback back();
    callback forward();
    callback reload();
    // x, y, action (0=down,1=up,2=move,3=cancel), button (0=none,1=left,2=right,3=middle), modifiers
    callback page-pointer(int, int, int, int, bool, bool, bool, bool);
    callback page-scroll(int, int, int, int, bool, bool, bool, bool);
    // key text, action (0=press,1=release), modifiers, repeat
    callback page-key(string, int, bool, bool, bool, bool, bool);
    callback page-focus(bool);

    callback create-workspace(string);
    callback edit-workspace(int, string, string, string);
    callback delete-workspace(int);
    callback reorder-workspace(int, int);
    callback switch-workspace(int);
    callback create-folder(int, string);
    callback edit-folder(int, string, string, string);
    callback delete-folder(int);
    callback move-folder(int, int);
    callback save-tab(int);
    callback move-tab(int, int, int);
    callback toggle-tab-pin(int);
    callback toggle-tab-favorite(int);
    callback search-workspaces(string, int);
    callback add-link(string, string);
    callback open-resource(int);
    callback remove-entry(int);
    callback move-entry(int, int, int);
    callback reorder-entry(int, int);
    callback toggle-entry-pin(int);
    callback toggle-resource-favorite(int);
    callback edit-resource(int, string, string, string, string, string);
    callback toggle-sidebar();
    toggle-sidebar => {
        if (root.sidebar-open && root.sidebar-locked) {
            root.sidebar-locked = false;
            root.sidebar-open = false;
        } else {
            root.sidebar-locked = true;
            root.sidebar-open = true;
        }
        open-delay.stop();
        close-delay.stop();
    }

    open-delay := Timer {
        interval: 150ms;
        running: false;
        triggered() => {
            self.stop();
            if (edge-trigger.has-hover && !root.sidebar-open) {
                root.sidebar-open = true;
                close-delay.start();
            }
        }
    }
    close-delay := Timer {
        interval: 1000ms;
        running: false;
        triggered() => {
            self.stop();
            if (!root.sidebar-locked && !sidebar-hover.has-hover && !edge-trigger.has-hover) {
                root.sidebar-open = false;
            }
        }
    }

    // This focus scope wraps the page as well as the controls so shortcuts
    // remain available when a site has the keyboard focus.
    shell-focus := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        KeyBinding {
            keys: @keys(Control + L);
            activated => { address.focus(); address.select-all(); }
        }
        KeyBinding {
            keys: @keys(Control + K);
            activated => { address.focus(); address.select-all(); }
        }
        KeyBinding {
            keys: @keys(Control + T);
            activated => { root.add-tab(); }
        }
        KeyBinding {
            keys: @keys(Control + W);
            activated => {
                if (root.active-tab-id >= 0) { root.close-tab(root.active-tab-id); }
            }
        }
        KeyBinding {
            keys: @keys(Control + Shift + F);
            activated => {
                root.sidebar-open = true;
                root.sidebar-locked = true;
                close-delay.stop();
                search-field.focus();
            }
        }
        KeyBinding {
            keys: @keys(Alt + E);
            activated => { root.toggle-sidebar(); }
        }
        KeyBinding {
            keys: @keys(Escape);
            enabled: root.sidebar-open && !root.sidebar-locked;
            activated => { root.sidebar-open = false; close-delay.stop(); }
        }

        VerticalLayout {
            spacing: 0px;
            header := Rectangle {
                height: 67px;
                background: #171923;
                // The address bar remains available even when the organizer is hidden.
                IconButton {
                    x: 36px;
                    y: 17px;
                    label: "☷";
                    description: "Afficher ou verrouiller les espaces (Alt+E)";
                    clicked => { root.toggle-sidebar(); }
                }
                omni := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 13px;
                    width: min(625px, root.width - 180px);
                    height: 42px;
                    border-radius: 12px;
                    background: #202330;
                    border-width: 1px;
                    border-color: address.has-focus ? #b4a1e5 : #353645;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 5px;
                        spacing: 1px;
                        IconButton { label: "←"; description: "Page précédente"; clicked => { root.back(); } }
                        IconButton { label: "→"; description: "Page suivante"; clicked => { root.forward(); } }
                        IconButton { label: "↻"; description: "Actualiser"; clicked => { root.reload(); } }
                        address := LineEdit {
                            text: root.current-url;
                            placeholder-text: "Rechercher ou saisir une URL";
                            font-size: 14px;
                            horizontal-stretch: 1;
                            accepted(text) => { root.navigate(text); }
                        }
                        IconButton { label: "↵"; description: "Naviguer"; clicked => { root.navigate(address.text); } }
                    }
                }
                IconButton {
                    x: parent.width - 53px;
                    y: 17px;
                    label: "+";
                    description: "Nouvel onglet (Ctrl+T)";
                    clicked => { root.add-tab(); }
                }
            }
            page-surface := Rectangle {
                background: #0f1318;
                vertical-stretch: 1;
                Image {
                    visible: root.has-page;
                    source: root.page-image;
                    image-fit: fill;
                    width: parent.width;
                    height: parent.height;
                }
                VerticalLayout {
                    visible: !root.has-page;
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Aster Browser";
                        font-size: 30px;
                        color: #e5e7eb;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.status-text;
                        color: #94a3b8;
                        horizontal-alignment: center;
                    }
                }
                page-focus-scope := FocusScope {
                    width: parent.width;
                    height: parent.height;
                    focus-on-tab-navigation: false;
                    focus-on-click: false;
                    focus-gained(reason) => { root.page-focus(true); }
                    focus-lost(reason) => { root.page-focus(false); }
                    key-pressed(event) => {
                        root.page-key(event.text, 0, event.modifiers.shift,
                                      event.modifiers.control, event.modifiers.alt,
                                      event.modifiers.meta, event.repeat);
                        accept
                    }
                    key-released(event) => {
                        root.page-key(event.text, 1, event.modifiers.shift,
                                      event.modifiers.control, event.modifiers.alt,
                                      event.modifiers.meta, false);
                        accept
                    }

                    page-hit := TouchArea {
                        property <int> pressed-button: 0;
                        property <bool> pointer-shift: false;
                        property <bool> pointer-control: false;
                        property <bool> pointer-alt: false;
                        property <bool> pointer-meta: false;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                page-focus-scope.focus();
                                self.pointer-shift = event.modifiers.shift;
                                self.pointer-control = event.modifiers.control;
                                self.pointer-alt = event.modifiers.alt;
                                self.pointer-meta = event.modifiers.meta;
                                if (event.button == PointerEventButton.left) { self.pressed-button = 1; }
                                else if (event.button == PointerEventButton.right) { self.pressed-button = 2; }
                                else if (event.button == PointerEventButton.middle) { self.pressed-button = 3; }
                                if (self.pressed-button > 0) {
                                    root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                                      0, self.pressed-button,
                                                      event.modifiers.shift, event.modifiers.control,
                                                      event.modifiers.alt, event.modifiers.meta);
                                }
                            } else if (event.kind == PointerEventKind.up) {
                                if (self.pressed-button > 0) {
                                    root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                                      1, self.pressed-button,
                                                      event.modifiers.shift, event.modifiers.control,
                                                      event.modifiers.alt, event.modifiers.meta);
                                }
                                self.pressed-button = 0;
                            } else if (event.kind == PointerEventKind.cancel) {
                                root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                                  3, 0, false, false, false, false);
                                self.pressed-button = 0;
                            }
                        }
                        moved => {
                            root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                              2, self.pressed-button,
                                              self.pointer-shift, self.pointer-control,
                                              self.pointer-alt, self.pointer-meta);
                        }
                        scroll-event(event) => {
                            root.page-scroll(self.mouse-x / 1px, self.mouse-y / 1px,
                                             event.delta-x / 1px, event.delta-y / 1px,
                                             event.modifiers.shift, event.modifiers.control,
                                             event.modifiers.alt, event.modifiers.meta);
                            accept
                        }
                    }
                }
            }
        }

        // A narrow, full-height edge target; outside this region the web page
        // continues receiving unchanged pointer coordinates.
        edge-trigger := TouchArea {
            x: 0px;
            y: 0px;
            width: 24px;
            height: root.height;
            enabled: !root.sidebar-open;
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover && !root.sidebar-open) { open-delay.start(); }
                else { open-delay.stop(); }
            }
            clicked => { root.toggle-sidebar(); }
        }

        organizer := Rectangle {
            x: root.sidebar-open ? 12px : -320px;
            y: 12px;
            width: 300px;
            height: min(root.height - 24px, 800px);
            border-radius: 17px;
            background: #1b1e2bf8;
            border-width: 1px;
            border-color: #ffffff19;
            animate x { duration: 180ms; }

            // Background hover region. The close timer never changes viewport
            // dimensions and does not perform a CEF resize.
            sidebar-hover := TouchArea {
                changed has-hover => {
                    if (self.has-hover) { close-delay.stop(); }
                    else if (root.sidebar-open && !root.sidebar-locked) { close-delay.start(); }
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 7px;
                            Text {
                                text: "Espaces";
                                color: #b6bacc;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                label: root.sidebar-locked ? "▣" : "□";
                                description: root.sidebar-locked ? "Désépingler la barre" : "Épingler la barre";
                                clicked => {
                                    root.sidebar-locked = !root.sidebar-locked;
                                    if (root.sidebar-locked) { close-delay.stop(); }
                                    else if (!sidebar-hover.has-hover) { close-delay.start(); }
                                }
                            }
                            IconButton {
                                label: "×";
                                description: "Masquer les espaces";
                                clicked => {
                                    root.sidebar-locked = false;
                                    root.sidebar-open = false;
                                    close-delay.stop();
                                }
                            }
                        }
                    }
                    ScrollView {
                        height: root.height < 650px ? 90px : 150px;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 267px;
                            spacing: 4px;
                            for space in root.spaces: SidebarSpace {
                                title: space.title;
                                glyph: space.icon == "code" ? "⌘" : (space.icon == "film" ? "▧" : (space.icon == "star" ? "★" : "▦"));
                                accent: space.color;
                                count: space.count;
                                active: space.active && !root.favorites-only;
                                chosen => { root.favorites-only = false; root.switch-workspace(space.id); }
                                editing => {
                                    root.sidebar-locked = true;
                                    close-delay.stop();
                                    root.editor-mode = 1;
                                    root.editor-tab-id = 0;
                                    root.editor-id = space.id;
                                    root.editor-title = space.title;
                                    root.editor-color = space.color-hex;
                                    root.editor-icon = space.icon;
                                    root.confirm-delete = false;
                                }
                            }
                            SidebarSpace {
                                title: "Favoris"; glyph: "★"; accent: #e5c9a2;
                                count: root.favorites.length; active: root.favorites-only;
                                chosen => { root.favorites-only = true; }
                                editing => { root.favorites-only = true; }
                            }
                        }
                    }
                    Rectangle {
                        height: 29px;
                        HorizontalLayout {
                            spacing: 5px;
                            IconButton {
                                button-size: 28px; label: "+"; description: "Créer un espace";
                                clicked => { root.editor-mode = 1; root.editor-tab-id = 0; root.editor-id = 0; root.editor-title = ""; root.editor-color = "#9ddac8"; root.editor-icon = "grid"; root.sidebar-locked = true; close-delay.stop(); }
                            }
                            Text { text: "Créer un espace"; color: #9499ad; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 38px;
                        HorizontalLayout {
                            spacing: 4px;
                            search-field := LineEdit {
                                text <=> root.search-query;
                                placeholder-text: "Rechercher partout...";
                                font-size: 12px;
                                horizontal-stretch: 1;
                                changed text => { root.search-workspaces(text, root.search-scope); }
                            }
                            IconButton {
                                button-size: 27px;
                                label: root.search-scope == 0 ? "T" : (root.search-scope == 1 ? "O" : (root.search-scope == 2 ? "R" : "★"));
                                description: root.search-scope == 0 ? "Tout rechercher" :
                                    (root.search-scope == 1 ? "Onglets uniquement" :
                                    (root.search-scope == 2 ? "Ressources uniquement" : "Favoris uniquement"));
                                clicked => {
                                    root.search-scope = (root.search-scope + 1) % 4;
                                    root.search-workspaces(root.search-query, root.search-scope);
                                }
                            }
                            IconButton {
                                button-size: 27px; label: "×"; description: "Effacer la recherche";
                                clicked => { root.search-query = ""; }
                            }
                        }
                    }
                    if (root.search-query != ""): ScrollView {
                        height: min(235px, root.height / 3);
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 267px;
                            spacing: 4px;
                            for hit in root.search-results: SearchRow {
                                title: hit.title;
                                subtitle: hit.subtitle;
                                glyph: hit.glyph;
                                accent: hit.color;
                                selected => {
                                    if (hit.kind == 0) { root.select-tab(hit.tab-id); }
                                    else if (hit.kind == 1) {
                                        root.switch-workspace(hit.workspace-id);
                                        root.open-resource(hit.resource-id);
                                    } else { root.switch-workspace(hit.workspace-id); }
                                    root.favorites-only = false;
                                    root.search-query = "";
                                }
                            }
                            if (root.search-results.length == 0): Text {
                                text: "Aucun résultat local";
                                color: #8e93a9;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #373845; }
                    Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 4px;
                            Text {
                                text: "Onglets ouverts";
                                color: #8e93a9;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                label: "+";
                                description: "Nouvel onglet";
                                button-size: 29px;
                                clicked => { root.add-tab(); }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 267px;
                            spacing: 5px;
                            for tab in tabs: SidebarTab {
                                title: tab.title;
                                active: tab.active;
                                activated => {
                                    root.select-tab(tab.id);
                                    if (!root.sidebar-locked) { root.sidebar-open = false; }
                                }
                                closed => { root.close-tab(tab.id); }
                                organizing => {
                                    root.editor-mode = 6;
                                    root.editor-tab-id = tab.id;
                                    root.editor-title = tab.title;
                                    root.sidebar-locked = true;
                                    close-delay.stop();
                                }
                            }
                            if (root.tabs.length == 0): Text {
                                text: "Aucun onglet ouvert";
                                color: #8e93a9;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #343544; }
                    Rectangle {
                        height: 37px;
                        HorizontalLayout {
                            padding-left: 5px;
                            spacing: 4px;
                            Text {
                                text: root.favorites-only ? "Favoris enregistrés" : "Ressources et dossiers";
                                color: #b6accf;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                button-size: 28px;
                                label: "+";
                                description: "Ajouter une URL enregistrée";
                                clicked => { root.editor-mode = 4; root.editor-tab-id = 0; root.editor-title = ""; root.editor-url = "https://"; root.sidebar-locked = true; close-delay.stop(); }
                            }
                            IconButton {
                                button-size: 28px;
                                label: "▱";
                                description: "Créer un dossier virtuel";
                                clicked => { root.favorites-only = false; root.editor-mode = 2; root.editor-tab-id = 0; root.editor-id = 0; root.editor-parent-id = 0; root.editor-title = ""; root.editor-color = "#9ddac8"; root.editor-icon = "folder"; root.sidebar-locked = true; close-delay.stop(); }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 267px;
                            spacing: 5px;
                            for item in (root.favorites-only ? root.favorites : root.saved-items): SavedRow {
                                title: item.title;
                                depth: item.depth;
                                glyph: item.folder ? "▱" : (item.icon == "code" ? "⌘" : (item.icon == "film" ? "▣" : "◫"));
                                accent: item.color;
                                folder: item.folder;
                                pinned: item.pinned;
                                can-pin: item.id > 0;
                                favorite: item.favorite;
                                live: item.live;
                                opened => { root.open-resource(item.resource-id); }
                                pin-clicked => { if (item.id > 0) { root.toggle-entry-pin(item.id); } }
                                favorite-clicked => { root.toggle-resource-favorite(item.resource-id); }
                                editing => {
                                    root.editor-tab-id = 0;
                                    root.sidebar-locked = true; close-delay.stop();
                                    root.editor-mode = item.folder ? 2 : 3;
                                    root.editor-id = item.id;
                                    root.editor-resource-id = item.resource-id;
                                    root.editor-title = item.title;
                                    root.editor-url = item.subtitle;
                                    root.editor-notes = item.notes;
                                    root.editor-tags = item.tags;
                                    root.editor-color = item.color-hex;
                                    root.editor-icon = item.icon;
                                    root.editor-parent-id = 0;
                                    root.confirm-delete = false;
                                }
                            }
                            if ((root.favorites-only ? root.favorites.length : root.saved-items.length) == 0): Text {
                                text: "Aucune ressource enregistrée";
                                color: #8e93a9;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        height: 42px;
                        HorizontalLayout {
                            padding-left: 5px;
                            spacing: 6px;
                            IconButton {
                                button-size: 31px;
                                label: "☆";
                                description: "Enregistrer l'onglet actif";
                                clicked => { if (root.active-tab-id >= 0) { root.save-tab(root.active-tab-id); } }
                            }
                            Text { text: "Enregistrer l'onglet actif"; color: #9aa0b6; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    if (root.workspace-message != ""): Text {
                        text: root.workspace-message;
                        color: #e7aaa9;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 20px;
                        Text {
                            text: "Alt+E : afficher / verrouiller";
                            color: #727a92;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            // Modal-like panel editor. It captures pointer events and pins the sidebar
            // while a form is in use; CEF remains at the same viewport size.
            editor-overlay := Rectangle {
                visible: root.editor-mode != 0;
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                border-radius: 16px;
                background: #1b1e2b;
                TouchArea { width: parent.width; height: parent.height; }
                VerticalLayout {
                    padding: 13px;
                    spacing: 11px;
                    HorizontalLayout {
                        spacing: 7px;
                        Text {
                            text: root.editor-mode == 1 ? "Espace" : (root.editor-mode == 2 ? "Dossier" : (root.editor-mode == 3 ? "Ressource" : (root.editor-mode == 4 ? "Enregistrer une URL" : (root.editor-mode == 6 ? "Organiser l'onglet" : "Ranger"))));
                            font-size: 17px;
                            color: #ececf6;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        IconButton { label: "×"; description: "Fermer l'éditeur"; clicked => { root.editor-mode = 0; root.editor-tab-id = 0; root.confirm-delete = false; } }
                    }
                    Rectangle { height: 1px; background: #383744; }
                    editor-fields := ScrollView {
                        visible: root.editor-mode != 5 && root.editor-mode != 6;
                        height: root.editor-mode == 5 || root.editor-mode == 6 ? 0px : max(110px, organizer.height - 165px);
                        vertical-stretch: root.editor-mode == 5 || root.editor-mode == 6 ? 0 : 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Nom ou titre"; font-size: 12px; color: #a7aac0; }
                            name-field := LineEdit { text: root.editor-title; placeholder-text: "Nom"; }
                            if (root.editor-mode == 4): Text { text: "Adresse URL HTTP(S)"; font-size: 12px; color: #a7aac0; }
                            url-field := LineEdit { visible: root.editor-mode == 4; text: root.editor-url; placeholder-text: "https://example.org"; }
                            if (root.editor-mode == 3): Text { text: "Note"; font-size: 12px; color: #a7aac0; }
                            note-field := LineEdit { visible: root.editor-mode == 3; text: root.editor-notes; placeholder-text: "Annotation"; }
                            if (root.editor-mode == 3): Text { text: "Mots-clés (séparés par des virgules)"; font-size: 12px; color: #a7aac0; }
                            tags-field := LineEdit { visible: root.editor-mode == 3; text: root.editor-tags; placeholder-text: "lecture, recherche"; }
                            if (root.editor-mode != 4): Text { text: "Couleur (#RRGGBB)"; font-size: 12px; color: #a7aac0; }
                            color-field := LineEdit { visible: root.editor-mode != 4; text: root.editor-color; placeholder-text: "#9ddac8"; }
                            if (root.editor-mode != 4): HorizontalLayout {
                                spacing: 5px;
                                IconButton { label: "●"; label-color: #9ddac8; description: "Vert doux"; clicked => { root.editor-color = "#9ddac8"; } }
                                IconButton { label: "●"; label-color: #bdacfc; description: "Lilas"; clicked => { root.editor-color = "#bdacfc"; } }
                                IconButton { label: "●"; label-color: #a7c9ee; description: "Bleu"; clicked => { root.editor-color = "#a7c9ee"; } }
                                IconButton { label: "●"; label-color: #e5c9a2; description: "Sable"; clicked => { root.editor-color = "#e5c9a2"; } }
                                IconButton { label: "●"; label-color: #e7aaa9; description: "Rose"; clicked => { root.editor-color = "#e7aaa9"; } }
                            }
                            if (root.editor-mode != 4): Text { text: "Icône"; font-size: 12px; color: #a7aac0; }
                            icon-field := LineEdit { visible: root.editor-mode != 4; text: root.editor-icon; placeholder-text: "grid"; }
                            if (root.editor-mode != 4): HorizontalLayout {
                                spacing: 3px;
                                IconButton { button-size: 29px; label: "▦"; description: "Grille"; clicked => { root.editor-icon = "grid"; } }
                                IconButton { button-size: 29px; label: "◉"; description: "Web"; clicked => { root.editor-icon = "globe"; } }
                                IconButton { button-size: 29px; label: "▱"; description: "Dossier"; clicked => { root.editor-icon = "folder"; } }
                                IconButton { button-size: 29px; label: "⌘"; description: "Code"; clicked => { root.editor-icon = "code"; } }
                                IconButton { button-size: 29px; label: "▧"; description: "Film"; clicked => { root.editor-icon = "film"; } }
                                IconButton { button-size: 29px; label: "★"; description: "Étoile"; clicked => { root.editor-icon = "star"; } }
                                IconButton { button-size: 29px; label: "☁"; description: "Nuage"; clicked => { root.editor-icon = "cloud"; } }
                            }
                            if (root.editor-mode != 4): Text {
                                text: "grid, code, film, book, star, folder, globe, file, cloud, terminal, pin, link";
                                color: #8b90a7;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 8px; }
                        }
                    }
                    if (root.editor-mode == 6): VerticalLayout {
                        spacing: 10px;
                        Text { text: root.editor-title; font-size: 14px; color: #daddec; wrap: word-wrap; }
                        Text { text: "Un déplacement conserve l'onglet Chromium actif et enregistre sa référence à destination.";
                            font-size: 11px; color: #9ca3b8; wrap: word-wrap; }
                        IconButton {
                            label: "☆"; description: "Enregistrer cet onglet dans l'espace";
                            clicked => { root.save-tab(root.editor-tab-id); root.editor-tab-id = 0; root.editor-mode = 0; }
                        }
                        Text { text: "Enregistrer l'URL"; font-size: 12px; color: #d3d5e4; }
                        IconButton {
                            label: "◆"; description: "Épingler ou désépingler cet onglet enregistré";
                            clicked => { root.toggle-tab-pin(root.editor-tab-id); root.editor-tab-id = 0; root.editor-mode = 0; }
                        }
                        Text { text: "Épingler / désépingler"; font-size: 12px; color: #d3d5e4; }
                        IconButton {
                            label: "★"; description: "Ajouter ou retirer cet onglet des favoris";
                            clicked => { root.toggle-tab-favorite(root.editor-tab-id); root.editor-tab-id = 0; root.editor-mode = 0; }
                        }
                        Text { text: "Favori / non favori"; font-size: 12px; color: #d3d5e4; }
                        IconButton {
                            label: "⇄"; description: "Déplacer l'onglet dans un espace ou dossier";
                            clicked => { root.editor-mode = 5; root.editor-resource-id = 0; root.editor-id = 0; }
                        }
                        Text { text: "Déplacer vers…"; font-size: 12px; color: #d3d5e4; }
                    }
                    if (root.editor-mode == 5): ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 5px;
                            for target in root.destinations: Rectangle {
                                visible: root.editor-tab-id > 0 || root.editor-resource-id != 0 || target.workspace-id == root.active-workspace-id;
                                height: 34px;
                                border-radius: 8px;
                                background: destination-hit.has-hover ? #35354a : #292c3b;
                                Text {
                                    x: 8px; y: 5px;
                                    width: parent.width - 16px;
                                    text: target.title;
                                    color: #d8d9e9;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                destination-hit := TouchArea {
                                    clicked => {
                                        if (root.editor-tab-id > 0) {
                                            root.move-tab(root.editor-tab-id, target.workspace-id, target.folder-id);
                                        } else if (root.editor-resource-id == 0) { root.move-folder(root.editor-id, target.folder-id); }
                                        else { root.move-entry(root.editor-id, target.workspace-id, target.folder-id); }
                                        root.editor-tab-id = 0;
                                        root.editor-mode = 0;
                                    }
                                }
                            }
                        }
                    }
                    if (root.editor-mode != 5 && root.editor-mode != 6): IconButton {
                        button-size: 38px;
                        label: "✓";
                        description: "Enregistrer les changements";
                        clicked => {
                            if (root.editor-mode == 1) {
                                if (root.editor-id == 0) { root.create-workspace(name-field.text); }
                                else { root.edit-workspace(root.editor-id, name-field.text, color-field.text, icon-field.text); }
                            } else if (root.editor-mode == 2) {
                                if (root.editor-id == 0) { root.create-folder(root.editor-parent-id, name-field.text); }
                                else { root.edit-folder(root.editor-id, name-field.text, color-field.text, icon-field.text); }
                            } else if (root.editor-mode == 3) {
                                root.edit-resource(root.editor-resource-id, name-field.text, note-field.text, tags-field.text, color-field.text, icon-field.text);
                            } else if (root.editor-mode == 4) { root.add-link(url-field.text, name-field.text); }
                            root.editor-mode = 0;
                        }
                    }
                    if (root.editor-mode == 1 && root.editor-id > 0): HorizontalLayout {
                        spacing: 4px;
                        IconButton { button-size: 30px; label: "↑"; description: "Monter l'espace"; clicked => { root.reorder-workspace(root.editor-id, -1); } }
                        IconButton { button-size: 30px; label: "↓"; description: "Descendre l'espace"; clicked => { root.reorder-workspace(root.editor-id, 1); } }
                        IconButton {
                            button-size: 30px; label: root.confirm-delete ? "✓" : "⊗";
                            description: root.confirm-delete ? "Confirmer la suppression de l'espace (les ressources sont conservées)" : "Supprimer l'espace";
                            clicked => { if (root.confirm-delete) { root.delete-workspace(root.editor-id); root.editor-mode = 0; root.editor-tab-id = 0; root.confirm-delete = false; } else { root.confirm-delete = true; } }
                        }
                    }
                    if (root.editor-mode == 2 && root.editor-id > 0): HorizontalLayout {
                        spacing: 4px;
                        IconButton { button-size: 30px; label: "+"; description: "Créer un sous-dossier"; clicked => { root.editor-parent-id = root.editor-id; root.editor-id = 0; root.editor-title = ""; } }
                        IconButton { button-size: 30px; label: "⇄"; description: "Déplacer le dossier"; clicked => { root.editor-resource-id = 0; root.editor-mode = 5; } }
                        IconButton {
                            button-size: 30px; label: root.confirm-delete ? "✓" : "⊗";
                            description: "Supprimer le dossier en conservant les ressources";
                            clicked => { if (root.confirm-delete) { root.delete-folder(root.editor-id); root.editor-mode = 0; root.editor-tab-id = 0; root.confirm-delete = false; } else { root.confirm-delete = true; } }
                        }
                    }
                    if (root.editor-mode == 3): HorizontalLayout {
                        spacing: 4px;
                        IconButton { button-size: 30px; label: "★"; description: "Favori"; clicked => { root.toggle-resource-favorite(root.editor-resource-id); } }
                        if (root.editor-id > 0): IconButton { button-size: 30px; label: "◆"; description: "Épingler / désépingler"; clicked => { root.toggle-entry-pin(root.editor-id); } }
                        if (root.editor-id > 0): IconButton { button-size: 30px; label: "↑"; description: "Monter"; clicked => { root.reorder-entry(root.editor-id, -1); } }
                        if (root.editor-id > 0): IconButton { button-size: 30px; label: "↓"; description: "Descendre"; clicked => { root.reorder-entry(root.editor-id, 1); } }
                        if (root.editor-id > 0): IconButton { button-size: 30px; label: "⇄"; description: "Ranger"; clicked => { root.editor-mode = 5; } }
                        if (root.editor-id > 0): IconButton {
                            button-size: 30px; label: root.confirm-delete ? "✓" : "⊗";
                            description: "Retirer cette référence (sans fermer l'onglet)";
                            clicked => { if (root.confirm-delete) { root.remove-entry(root.editor-id); root.editor-mode = 0; root.editor-tab-id = 0; root.confirm-delete = false; } else { root.confirm-delete = true; } }
                        }
                    }
                    if (root.confirm-delete): Text { text: "Appuyer de nouveau sur ✓ pour confirmer"; color: #e7aaa9; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
}
