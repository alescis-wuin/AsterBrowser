import { LineEdit } from "std-widgets.slint";

export struct TabView {
    id: int,
    title: string,
    active: bool,
}

component ToolbarButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: hit.pressed ? #384353 : (hit.has-hover ? #303946 : #252b36);
    Text {
        text: root.label;
        color: #e5e7eb;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea { clicked => { root.clicked(); } }
}

component TabChip inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback activated();
    callback closed();
    width: 190px;
    height: 36px;
    border-radius: 9px;
    background: root.active ? #303d52 : #202733;
    border-width: root.active ? 1px : 0px;
    border-color: #5689de;

    // The tab activation area sits *under* the close button.
    activate-hit := TouchArea { clicked => { root.activated(); } }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 7px;
        spacing: 5px;
        Text {
            text: root.title;
            color: root.active ? #ffffff : #bcc8dc;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 5px;
            background: close-hit.has-hover ? #52627b : #00000000;
            Text {
                text: "×";
                color: #e1e8f4;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-hit := TouchArea { clicked => { root.closed(); } }
        }
    }
}

export component BrowserWindow inherits Window {
    title: "Aster Browser — P0 Chromium";
    preferred-width: 1120px;
    preferred-height: 740px;
    min-width: 650px;
    min-height: 400px;
    background: #0f1318;

    in property <[TabView]> tabs;
    in property <string> current-url;
    in property <string> status-text;
    in property <image> page-image;
    in property <bool> has-page;
    out property <int> viewport-width: page-surface.width / 1px;
    out property <int> viewport-height: page-surface.height / 1px;

    callback add-tab();
    callback close-tab(int);
    callback select-tab(int);
    callback navigate(string);
    callback back();
    callback forward();
    callback reload();
    // x, y, action (0=down,1=up,2=move,3=cancel), button (0=none,1=left,2=right,3=middle), modifiers
    callback page-pointer(int, int, int, int, bool, bool, bool, bool);
    callback page-scroll(int, int, int, int, bool, bool, bool, bool);
    // key text, action (0=press,1=release), modifiers, repeat
    callback page-key(string, int, bool, bool, bool, bool, bool);
    callback page-focus(bool);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 47px;
            background: #181d25;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 6px;
                for tab in tabs: TabChip {
                    title: tab.title;
                    active: tab.active;
                    activated => { root.select-tab(tab.id); }
                    closed => { root.close-tab(tab.id); }
                }
                ToolbarButton { label: "+"; clicked => { root.add-tab(); } }
            }
        }
        Rectangle {
            height: 52px;
            background: #141b24;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                ToolbarButton { label: "←"; clicked => { root.back(); } }
                ToolbarButton { label: "→"; clicked => { root.forward(); } }
                ToolbarButton { label: "↻"; clicked => { root.reload(); } }
                address := LineEdit {
                    text: root.current-url;
                    horizontal-stretch: 1;
                    accepted => { root.navigate(self.text); }
                }
                ToolbarButton { label: "Go"; clicked => { root.navigate(address.text); } }
            }
        }
        page-surface := Rectangle {
            background: #0f1318;
            vertical-stretch: 1;
            Image {
                visible: root.has-page;
                source: root.page-image;
                image-fit: fill;
                width: parent.width;
                height: parent.height;
            }
            VerticalLayout {
                visible: !root.has-page;
                alignment: center;
                spacing: 12px;
                Text {
                    text: "Aster Browser";
                    font-size: 30px;
                    color: #e5e7eb;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.status-text;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
            }
            page-focus-scope := FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-tab-navigation: false;
                focus-on-click: false;
                focus-gained(reason) => { root.page-focus(true); }
                focus-lost(reason) => { root.page-focus(false); }
                key-pressed(event) => {
                    root.page-key(event.text, 0, event.modifiers.shift,
                                  event.modifiers.control, event.modifiers.alt,
                                  event.modifiers.meta, event.repeat);
                    accept
                }
                key-released(event) => {
                    root.page-key(event.text, 1, event.modifiers.shift,
                                  event.modifiers.control, event.modifiers.alt,
                                  event.modifiers.meta, false);
                    accept
                }

                page-hit := TouchArea {
                    property <int> pressed-button: 0;
                    property <bool> pointer-shift: false;
                    property <bool> pointer-control: false;
                    property <bool> pointer-alt: false;
                    property <bool> pointer-meta: false;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            page-focus-scope.focus();
                            self.pointer-shift = event.modifiers.shift;
                            self.pointer-control = event.modifiers.control;
                            self.pointer-alt = event.modifiers.alt;
                            self.pointer-meta = event.modifiers.meta;
                            if (event.button == PointerEventButton.left) { self.pressed-button = 1; }
                            else if (event.button == PointerEventButton.right) { self.pressed-button = 2; }
                            else if (event.button == PointerEventButton.middle) { self.pressed-button = 3; }
                            if (self.pressed-button > 0) {
                                root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                                  0, self.pressed-button,
                                                  event.modifiers.shift, event.modifiers.control,
                                                  event.modifiers.alt, event.modifiers.meta);
                            }
                        } else if (event.kind == PointerEventKind.up) {
                            if (self.pressed-button > 0) {
                                root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                                  1, self.pressed-button,
                                                  event.modifiers.shift, event.modifiers.control,
                                                  event.modifiers.alt, event.modifiers.meta);
                            }
                            self.pressed-button = 0;
                        } else if (event.kind == PointerEventKind.cancel) {
                            root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                              3, 0, false, false, false, false);
                            self.pressed-button = 0;
                        }
                    }
                    moved => {
                        root.page-pointer(self.mouse-x / 1px, self.mouse-y / 1px,
                                          2, self.pressed-button,
                                          self.pointer-shift, self.pointer-control,
                                          self.pointer-alt, self.pointer-meta);
                    }
                    scroll-event(event) => {
                        root.page-scroll(self.mouse-x / 1px, self.mouse-y / 1px,
                                         event.delta-x / 1px, event.delta-y / 1px,
                                         event.modifiers.shift, event.modifiers.control,
                                         event.modifiers.alt, event.modifiers.meta);
                        accept
                    }
                }
            }
        }
    }
}
